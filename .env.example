APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Gen 1 default tenant key: meg_local_<32 chars>
# Hash is computed at startup; plaintext only for local/dev.
DEV_API_KEY=meg_local_devkey00000000000000000001
DEFAULT_TENANT_SLUG=demo

DATABASE_URL=postgresql+psycopg://megmis:megmis@localhost:5433/megmis
REDIS_URL=redis://localhost:6379/0
USE_PERSISTENCE=true
DEV_API_KEY_B=meg_local_tenantb00000000000000000002
RATE_LIMIT_PER_MINUTE=120
OSM_EXTRACT_PATH=data/osm/zimbabwe-harare-bulawayo.osm
GRAPH_REFRESH_DIR=data/osm/.graph_refresh

WEATHER_PROVIDER=mock
ROUTING_PROVIDER=mock
GEOCODE_PROVIDER=nominatim
SPEECH_PROVIDER=whisper
WHISPER_MODEL=base
TTS_PROVIDER=edge
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_PROVIDER=edge
VOICE_DEFAULT_LANG=en
VOICE_AUDIO_DIR=data/audio
# Real adapters: open-meteo | openweather ; valhalla | graphhopper | osrm
# OPENWEATHER_KEY=
# VALHALLA_URL=http://localhost:8002
# GRAPHHOPPER_URL=http://localhost:8989
# OSRM_URL=https://router.project-osrm.org
# Gen 2: RLS app role (default on when DATABASE_APP_URL set)
DATABASE_APP_URL=postgresql+psycopg://megmis_app:megmis_app@localhost:5433/megmis
USE_APP_ROLE=true
WORKER_INTERVAL_SECONDS=60
WEBHOOK_MAX_ATTEMPTS=8
# Optional console service (compose --profile console)
CONSOLE_UPSTREAM=http://127.0.0.1:8000
CONSOLE_PORT=8088

OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Free Open-Meteo is NON-COMMERCIAL — leave false until licensed
OPEN_METEO_COMMERCIAL_OK=false
OPENWEATHER_KEY=
VALHALLA_URL=
GRAPHHOPPER_URL=

# Gen 4 failover chains (comma-separated)
WEATHER_FAILOVER=openweather,mock
ROUTING_FAILOVER=osrm,graphhopper,mock
GEOCODE_FAILOVER=mock
SPEECH_FAILOVER=mock

# Gen 4 object storage + secrets + retention
OBJECT_STORE_BACKEND=local
OBJECT_STORE_DIR=data/object-store
AUDIO_RETENTION_DAYS=30
EVIDENCE_RETENTION_DAYS=90
SECRET_MANAGER=env
# SECRET_FILE=/run/secrets/megmis.json
PII_SALT=megmis-pii
STRUCTURED_LOGS=true

MCP_TRANSPORT=http
# Streamable HTTP DNS-rebinding allowlist (comma-separated; host:* = any port)
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,testserver,testserver:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*,http://testserver:*
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=megmis
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_REGION=us-east-1
