{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.walter-kudzai-kamanga/megmis",
  "title": "Mamiriro (MEGMIS)",
  "description": "PROTOTYPE: Zimbabwe weather, geo, safe routing & journey risk via REST+MCP (stdio/HTTP).",
  "version": "0.1.0",
  "websiteUrl": "https://github.com/walter-kudzai-kamanga/megmis",
  "repository": {
    "url": "https://github.com/walter-kudzai-kamanga/megmis",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "megmis",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx",
      "environmentVariables": [
        {
          "name": "DEV_API_KEY",
          "description": "API key for mutating tools / tenant persistence (optional for read-only demos).",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "USE_PERSISTENCE",
          "description": "Set false for in-memory local stdio without Postgres/Redis.",
          "isRequired": false,
          "isSecret": false,
          "default": "false"
        },
        {
          "name": "GEOCODE_PROVIDER",
          "description": "Geocoding adapter: mock | nominatim",
          "isRequired": false,
          "isSecret": false,
          "default": "mock"
        },
        {
          "name": "WEATHER_PROVIDER",
          "description": "Weather adapter: mock | open-meteo | openweather",
          "isRequired": false,
          "isSecret": false,
          "default": "mock"
        },
        {
          "name": "ROUTING_PROVIDER",
          "description": "Routing adapter: mock | osrm | valhalla | graphhopper",
          "isRequired": false,
          "isSecret": false,
          "default": "mock"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://megmis-api.onrender.com/mcp/"
    }
  ]
}
